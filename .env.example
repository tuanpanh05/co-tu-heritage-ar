# Public base URL dùng để sinh QR Code chính xác khi quét từ điện thoại
# Khi chạy local: http://localhost:5173
# Khi deploy lên Vercel: https://cotuheritage.vercel.app
VITE_PUBLIC_BASE_URL=https://cotuheritage.vercel.app

# Supabase API Configuration (Lấy từ Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Supabase Secret Key (Chỉ dùng khi chạy script migration trên terminal, không đưa lên Vercel)
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key
